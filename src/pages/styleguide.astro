<script>
  import { createMotion, setupCanvas, cssVar, onThemeChange, ease } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-sg-motion]');
  const canvas = root?.querySelector('canvas');
  if (root && canvas) {
    // Zustand zuerst anlegen: setupCanvas ruft onResize sofort auf
    let colors = { green: cssVar('--green'), line: cssVar('--line'), muted: cssVar('--muted') };
    const N = 14;
    const seeds = Array.from({ length: N }, (_, i) => ({
      x: Math.sin(i * 12.9898) * 0.5 + 0.5,
      y: Math.cos(i * 78.233) * 0.5 + 0.5,
    }));
    let phase = 1;
    const view = setupCanvas(canvas, () => draw(Math.min(1, phase)));

    function draw(p: number) {
      const { ctx, width: w, height: h } = view;
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = colors.line;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(24, h - 24);
      ctx.lineTo(w - 24, 24);
      ctx.stroke();
      const k = ease(p);
      seeds.forEach((s, i) => {
        const tx = 24 + ((w - 48) * i) / (N - 1);
        const ty = h - 24 - ((h - 48) * i) / (N - 1);
        const x = s.x * w + (tx - s.x * w) * k;
        const y = s.y * h + (ty - s.y * h) * k;
        ctx.fillStyle = k > 0.98 ? colors.green : colors.muted;
        ctx.beginPath();
        ctx.arc(x, y, 5, 0, Math.PI * 2);
        ctx.fill();
      });
    }

    onThemeChange(() => {
      colors = { green: cssVar('--green'), line: cssVar('--line'), muted: cssVar('--muted') };
      draw(Math.min(1, phase));
    });

    createMotion({
      root,
      toggle: root.querySelector<HTMLButtonElement>('[data-motion-toggle]'),
      step: (dt) => {
        phase += dt / 1.6;
        if (phase > 2.4) phase = 0;
        draw(Math.min(1, phase));
      },
      renderStatic: () => {
        phase = 1;
        draw(1);
      },
    });
    draw(1);
  }
</script>

