---
/**
 * WorkingSteps – „Wie wir arbeiten“: vier Schritte ohne Wochenangaben + Grundsätze.
 * Texte aus src/config/arbeitsweise.ts (gleich wie auf der Leistungsseite).
 * Grundsätze sind laut docs/website-entscheidungen.md eine ANNAHME (Bestätigung ausstehend).
 */
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { grundsaetze, vorgehen } from '../../config/arbeitsweise';

const schritte = vorgehen;
---

<Section id="arbeitsweise" tone="alt" labelledby="arbeitsweise-titel" class="aw">
  <SectionHeader
    id="arbeitsweise-titel"
    eyebrow="Wie wir arbeiten"
    title="Vom ersten Gespräch bis zum laufenden Betrieb."
    intro="So gehen wir bei individuellen Projekten vor. Wie lange jeder Schritt dauert, hängt von Ihrem Vorhaben ab."
  />

  <ol class="steps" role="list">
    {
      schritte.map((s, i) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="step__title">{s.titel}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="principles">
    <h3 class="principles__title">Unsere Grundsätze</h3>
    <ul class="checklist principles__list">
      {grundsaetze.map((g) => <li>{g.titel}</li>)}
    </ul>
  </div>
</Section>

<style>
  /* -- Schritte: mobil senkrechte Zeitleiste, ab 900 px waagerecht ------- */
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-left: 2.25rem;
  }

  .steps::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(var(--green), var(--line));
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  /* Punkt auf der Linie */
  .step::before {
    content: '';
    position: absolute;
    left: -2.25rem;
    top: 0.2rem;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--green);
    border-radius: 50%;
    background: var(--surface);
  }

  .step:first-child::before {
    background: var(--green);
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    color: var(--green-text);
  }

  .step__title {
    font-size: var(--fs-xl);
  }

  .step__text {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 40ch;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
      padding-left: 0;
      padding-top: 2.25rem;
    }

    .steps::before {
      left: 0;
      right: 0;
      top: 0.4375rem;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--green), var(--line));
    }

    .step::before {
      left: 0;
      top: -2.25rem;
    }
  }

  /* -- Grundsätze -------------------------------------------------------- */
  .principles {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .principles__title {
    font-size: var(--fs-xl);
  }

  .principles__list {
    gap: var(--space-3) var(--space-6);
    font-weight: var(--fw-medium);
  }

  @media (min-width: 700px) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

</style>
