---
/**
 * EigenesBeispiel – das eigene Produkt als Kompetenzbeleg, bis freigegebene Referenzen vorliegen.
 * Nur belegte Eigenschaften und der Demo-Umfang (Anfrage bis Plantafel), docs/website-entscheidungen.md.
 * Referenzen fehlen bewusst (Release 2) – hier kein sichtbarer Platzhalter.
 */
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { ctas, product } from '../../config/site';
import { produktAblauf, produktBelege } from './inhalte';

const name = product.name;
---

<Section id="beispiel" tone="alt" labelledby="beispiel-titel">
  <div class="eb">
    <div class="eb__text">
      <SectionHeader id="beispiel-titel" eyebrow="Beispiel aus eigener Arbeit" title={`Wie wir bauen, zeigt ${name}.`}>
        <Fragment slot="intro">
          <p>
            {name} ist unsere eigene Software für Handwerks- und Baustellenbetriebe. Sie zeigt, wie wir an Software
            herangehen: ausgehend von einem konkreten Arbeitsalltag, mit einem durchgehenden Ablauf und sauberen Daten.
          </p>
        </Fragment>
      </SectionHeader>

      <ul class="eb__proofs" role="list">
        {
          produktBelege.map((b) => (
            <li class="eb__proof">
              <span class="eyebrow">{b.leistung}</span>
              <p class="eb__proof-text">{b.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="actions eb__actions">
        <Button href={ctas.produkt.href} variant="secondary" icon="arrow-up-right">{ctas.produkt.label}</Button>
      </div>
    </div>

    <div class="eb__panel">
      <div class="eb__panel-head">
        <p class="eb__brand">
          <span class="eb__brand-name">{name}</span>
          <span class="eb__brand-by">– {product.byline}</span>
        </p>
        <Badge kind="entwicklung">{product.statusLabel}</Badge>
      </div>
      <h3 class="label" id="eb-panel-titel">Ablauf in der Demo</h3>
      <ol class="eb__flow" role="list" aria-labelledby="eb-panel-titel">
        {
          produktAblauf.map((s, i) => (
            <li class="eb__flow-step">
              <span class="eb__flow-dot" aria-hidden="true" />
              <span class="eb__flow-nr tabular" aria-hidden="true">
                {i + 1}
              </span>
              <span class="eb__flow-text">{s}</span>
            </li>
          ))
        }
      </ol>
      <p class="eb__panel-note">
        Die Demo zeigen wir ausgewählten Betrieben. Einen Starttermin und Preise gibt es noch nicht.
      </p>
    </div>
  </div>
</Section>

<style>
  .eb {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .eb {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(3rem, 2rem + 3vw, 5rem);
    }
  }

  .eb__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .eb__text :global(.section-header) {
    margin-bottom: 0;
  }

  .eb__proofs {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .eb__proof {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .eb__proof-text {
    font-size: var(--fs-sm);
  }

  /* -- Panel: Ablauf in der Demo -------------------------------------------- */
  .eb__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .eb__panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .eb__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
    font-size: var(--fs-lg);
    line-height: 1.3;
  }

  .eb__brand-name {
    font-weight: var(--fw-bold);
    letter-spacing: -0.015em;
  }

  .eb__brand-by {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .eb__flow {
    display: grid;
  }

  .eb__flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2);
    padding-block: 0.45rem;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  /* Verbindungslinie zwischen den Punkten */
  .eb__flow-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(0.625rem - 0.5px);
    top: 1.35rem;
    bottom: -0.55rem;
    width: 1px;
    background: var(--green-line);
  }

  .eb__flow-dot {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    margin: 0.3rem auto 0;
    border: 2px solid var(--green);
    border-radius: 50%;
    background: var(--card);
  }

  .eb__flow-step:last-child .eb__flow-dot {
    background: var(--green);
  }

  .eb__flow-nr {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    padding-top: 0.1rem;
  }

  .eb__panel-note {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }
</style>
