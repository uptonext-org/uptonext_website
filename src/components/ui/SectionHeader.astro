---
/**
 * SectionHeader – Eyebrow, Überschrift, Einleitung (+ optionale Aktionen im Slot).
 *
 * <SectionHeader id="leistungen-titel" eyebrow="Leistungen" title="Was wir für Sie bauen"
 *   intro="Individuelle Software, wenn Standardlösungen nicht passen." />
 *
 * Aktionen (Slot „actions“ oder Default) stehen in einer .actions-Zeile: unter 480 px volle Breite.
 *
 * Hervorhebung im Titel über den Slot „title“:
 * <SectionHeader headingLevel={1} id="hero-titel">
 *   <Fragment slot="title">Software, die Abläufe <span class="text-green">einfacher macht.</span></Fragment>
 *   <Button slot="actions" href="/kontakt/">…</Button>
 * </SectionHeader>
 */
import type { HTMLAttributes } from 'astro/types';
import type { HeadingLevel } from './types';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  eyebrow?: string;
  title?: string;
  /** Ebene der Überschrift (Standard 2). Eine sichtbare H1 je Seite. */
  headingLevel?: HeadingLevel;
  /** Visuelle Größe, unabhängig von der Ebene. Standard: 1 → '3xl', 2 → '2xl', 3/4 → 'xl' */
  size?: 'xl' | '2xl' | '3xl';
  intro?: string;
  align?: 'start' | 'center';
  /** id der Überschrift (für Section labelledby) */
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  headingLevel = 2,
  size,
  intro,
  align = 'start',
  id,
  class: className,
  ...rest
} = Astro.props;

const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3' | 'h4';
const visual = size ?? (headingLevel === 1 ? '3xl' : headingLevel === 2 ? '2xl' : 'xl');
const hasIntroSlot = Astro.slots.has('intro');
const hasActions = Astro.slots.has('actions') || Astro.slots.has('default');
---

<div class:list={['section-header', `section-header--${align}`, className]} {...rest}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id} class:list={['section-header__title', `section-header__title--${visual}`]}>
    <slot name="title">{title}</slot>
  </Heading>
  {
    (intro || hasIntroSlot) && (
      <div class="section-header__intro lede">
        <slot name="intro">
          <p>{intro}</p>
        </slot>
      </div>
    )
  }
  {
    hasActions && (
      <div class="section-header__actions actions">
        <slot name="actions" />
        <slot />
      </div>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }

  .section-header:last-child {
    margin-bottom: 0;
  }

  .section-header--center {
    align-items: center;
    text-align: center;
  }

  .section-header--center > * {
    margin-inline: auto;
  }

  .section-header .eyebrow {
    margin-bottom: calc(var(--space-1) * -1);
  }

  .section-header__title--3xl {
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 18ch;
  }

  .section-header__title--2xl {
    font-size: var(--fs-2xl);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .section-header__title--xl {
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-snug);
    max-width: 32ch;
  }

  .section-header__intro {
    max-width: 58ch;
  }

  .section-header__intro :global(p + p) {
    margin-top: 0.75em;
  }

  .section-header__actions {
    margin-top: var(--space-3);
  }

  .section-header--center .section-header__actions {
    justify-content: center;
  }
</style>
