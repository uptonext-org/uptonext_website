---
/**
 * Base – Grundlayout jeder Seite.
 *
 * ---
 * import Base from '../layouts/Base.astro';
 * ---
 * <Base title="Leistungen" description="… (≤ 155 Zeichen)">
 *   …Sektionen…
 * </Base>
 *
 * - <title>: „{title} – UpToNext“; enthält title bereits „UpToNext“, bleibt er unverändert.
 * - canonical/og:url aus Astro.url + site; bei noindex kein canonical.
 * - Theme: Inline-Skript setzt nur eine gespeicherte Wahl, sonst gilt prefers-color-scheme.
 * - Header-CTA: Standard je Pfad (/tafelwerk/ → Demo, /leistungen/ → Erstgespräch,
 *   /kontakt/ → keiner, sonst „Kontakt aufnehmen“); über `headerCta` überschreibbar.
 */
import '../styles/global.css';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { company, meta, pages, theme, url as siteUrl, type CtaKey } from '../config/site';

interface Props {
  /** Seitentitel ohne Markenzusatz */
  title: string;
  /** Meta-Description, höchstens 155 Zeichen */
  description?: string;
  /** noindex,nofollow (Styleguide, 404, Bestätigungsseiten) */
  noindex?: boolean;
  /** Open-Graph-Bild (Pfad in public/ oder absolute URL), 1200 × 630 */
  ogImage?: string;
  /** Alternativtext des OG-Bilds */
  ogImageAlt?: string;
  /** zusätzliche Klasse(n) am <body> */
  bodyClass?: string;
  /** CTA im Header; 'none' = keiner */
  headerCta?: CtaKey | 'none';
}

const {
  title,
  description = meta.defaultDescription,
  noindex = false,
  ogImage,
  ogImageAlt,
  bodyClass,
  headerCta,
} = Astro.props;

const site = Astro.site ?? new URL(siteUrl);
const fullTitle = title.includes(company.name) ? title : `${title} – ${company.name}`;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage ?? meta.ogImage.src, site).href;
const isDefaultOg = !ogImage;

const path = Astro.url.pathname;
const autoCta: CtaKey | 'none' = path.startsWith(pages.tafelwerk)
  ? 'tafelwerk'
  : path.startsWith(pages.leistungen)
    ? 'projekt'
    : path.startsWith(pages.kontakt)
      ? 'none'
      : 'kontakt';
const cta = headerCta ?? autoCta;

// JSON-LD: nur belegte Felder
const organization: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': `${site.origin}/#organization`,
  name: company.name,
  url: `${site.origin}/`,
  logo: new URL('/brand/uptonext-stacked-light.png', site).href,
  email: company.email,
};
if (company.legalName) organization.legalName = company.legalName;
if (company.phone) organization.telephone = company.phone;
if (company.address) {
  organization.address = {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    postalCode: company.address.postalCode,
    addressLocality: company.address.city,
    addressCountry: company.address.country,
  };
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: `${site.origin}/`,
      name: company.name,
      inLanguage: 'de-DE',
      publisher: { '@id': `${site.origin}/#organization` },
    },
  ],
};

// Vor dem ersten Rendern: gespeicherte Wahl anwenden (sonst nichts setzen) und html.js markieren
const themeScript = `(function(d){d.classList.add('js');try{var t=localStorage.getItem(${JSON.stringify(
  theme.storageKey,
)});if(t==='light'||t==='dark')d.setAttribute('data-theme',t)}catch(e){}})(document.documentElement)`;

const fontFace = `@font-face{font-family:'Figtree Variable';font-style:normal;font-display:swap;font-weight:300 900;src:url(${figtreeLatin}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <script is:inline set:html={themeScript} />

    <meta name="theme-color" content={theme.colors.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={theme.colors.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {isDefaultOg && <meta property="og:image:width" content={String(meta.ogImage.width)} />}
    {isDefaultOg && <meta property="og:image:height" content={String(meta.ogImage.height)} />}
    <meta property="og:image:alt" content={ogImageAlt ?? meta.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header cta={cta} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
